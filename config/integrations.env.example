# Installed root:root 0600; systemd passes it only to the integration worker.
# Populate only the enabled connectors. No real credentials belong in Git.
# Explicação por IA (provedor padrão: NVIDIA API Catalog). Gere a chave em build.nvidia.com.
NVIDIA_API_KEY=
# Legado: somente se integrations.kiro continuar habilitado.
KIRO_API_KEY=
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
QRADAR_TOKEN=
VISION_ONE_TOKEN=
EYEMOLE_WAZUH_USER=
EYEMOLE_WAZUH_PASSWORD=
# JSON map of Wazuh agent ID to a distinct random key of at least 32 characters.
# Matching key belongs in /etc/eyemole/execution.json on that agent, root:root 0600.
EYEMOLE_AGENT_KEYS="{}"
